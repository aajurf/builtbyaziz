# Cal.com -> Resend booking email. Set these in Vercel:
# Project > Settings > Environment Variables (Production + Preview).
# Never commit real values — .env* is gitignored.

# Signing secret you set on the Cal.com webhook. The endpoint refuses any
# request that is not signed with this, so it must match Cal exactly.
CAL_WEBHOOK_SECRET=

# Resend API key (starts re_). https://resend.com/api-keys
RESEND_API_KEY=

# Verified sender. Resend verifies the ROOT domain, and the DKIM key lives at
# resend._domainkey.builtbyaziz.com — so the From address is @builtbyaziz.com.
# The send. subdomain holds only SPF and the bounce MX (Resend's return path);
# it is not a sending identity, and using it here gets the send rejected.
# Replies go to aziz@builtbyaziz.com on Hostinger, set by the route itself.
BOOKING_FROM="Aziz Eljurf <aziz@builtbyaziz.com>"
