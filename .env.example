# Cal.com -> Resend booking email. Set these in Vercel:
# Project > Settings > Environment Variables (Production + Preview).
# Never commit real values — .env* is gitignored.

# Signing secret you set on the Cal.com webhook. The endpoint refuses any
# request that is not signed with this, so it must match Cal exactly.
CAL_WEBHOOK_SECRET=

# Resend API key (starts re_). https://resend.com/api-keys
RESEND_API_KEY=

# Verified sender. Must be on a domain verified in Resend. Using the
# send. subdomain keeps Hostinger's mail on the root domain untouched.
BOOKING_FROM="Aziz Eljurf <aziz@send.builtbyaziz.com>"
